APP_ENV=development
APP_URL=http://localhost:8080
APP_KEY=replace-with-at-least-32-random-characters
APP_TIMEZONE=America/New_York
SESSION_SECURE=false
ALMA_ENABLE_NOTE_UPDATES=false
ALMA_CLAIMS_NOTE_TYPE=OTHER

# Use a managed MySQL/MariaDB database for shared or Azure hosting.
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=claims_report;charset=utf8mb4
DB_USER=claims_app
DB_PASSWORD=

# Comma-separated member slugs, each mapped to an Alma key variable below.
ALMA_MEMBERS=gw,au,cua,udc,gallaudet,gmu,georgetown,howard,marymount
ALMA_BASE_URL=https://api-na.hosted.exlibrisgroup.com/almaws/v1
ALMA_KEY_GW=
ALMA_KEY_AU=
ALMA_KEY_CUA=
ALMA_KEY_UDC=
ALMA_KEY_GALLAUDET=
ALMA_KEY_GMU=
ALMA_KEY_GEORGETOWN=
ALMA_KEY_HOWARD=
ALMA_KEY_MARYMOUNT=

# Email: configure the local MTA or a provider relay supported by PHP mail().
MAIL_FROM=claims@wrlc.org
MAIL_FROM_NAME=WRLC Claims Returned


# Optional initial setup: create the first administrator through bin/create-user.php.
